# name: test/sql/discovery.test
# description: Discovery table functions (supported_phone_regions, card_brands, supported_postal_countries)
# group: [vgi_conform]

require-env VGI_CONFORM_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'conform' AS conform (TYPE vgi, LOCATION '${VGI_CONFORM_WORKER}');

# ---- supported_phone_regions() ----

query I
SELECT count(*) > 100 FROM conform.supported_phone_regions();
----
true

query I
SELECT country_code FROM conform.supported_phone_regions() WHERE region = 'US';
----
1

query I
SELECT country_code FROM conform.supported_phone_regions() WHERE region = 'GB';
----
44

# ---- card_brands() ----

query I
SELECT count(*) FROM conform.card_brands();
----
6

query I rowsort
SELECT brand FROM conform.card_brands();
----
amex
diners
discover
jcb
mastercard
visa

# card_brand only ever returns a brand listed by card_brands().
query I
SELECT conform.card_brand('5555555555554444') IN (SELECT brand FROM conform.card_brands());
----
true

# ---- supported_postal_countries() ----

query I
SELECT count(*) > 0 FROM conform.supported_postal_countries();
----
true

query I
SELECT count(*) > 0 FROM conform.supported_postal_countries() WHERE country = 'US';
----
true

# The listed countries are exactly what is_valid_postal_code accepts: 'US' is
# listed here, and a constant 'US' validates without the unknown-country error.
query I
SELECT conform.is_valid_postal_code('90210', 'US')
  AND EXISTS (SELECT 1 FROM conform.supported_postal_countries() WHERE country = 'US');
----
true

statement ok
DETACH conform;
